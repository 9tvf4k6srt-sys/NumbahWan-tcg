{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": [
      "ESNext"
    ],
    "types": ["vite/client", "@cloudflare/workers-types", "node"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "rulai-temple",
    "packages",
    "nwge-engine",
    "nwge-web",
    "tests",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}